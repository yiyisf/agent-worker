{
  "name": "conductor-agent-worker",
  "private": true,
  "version": "0.0.0",
  "description": "AI Agent Worker SDK for the Conductor OSS orchestration engine",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "docs:check-mermaid": "node scripts/check-mermaid.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0"
  }
}

{
  "name": "@ca/conductor",
  "version": "0.0.0",
  "description": "官方 @io-orkes/conductor-javascript 之上的薄桥接层：Worker 编译、租约策略、结果映射、TaskDef 推导",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/envelope/index.ts --format esm,cjs --dts --clean --sourcemap --target node20",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "@io-orkes/conductor-javascript": "4.0.0"
  },
  "dependencies": {
    "@ca/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@io-orkes/conductor-javascript": "4.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js",
      "require": "./dist/envelope/index.cjs"
    }
  }
}

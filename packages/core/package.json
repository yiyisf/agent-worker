{
  "name": "@ca/core",
  "version": "0.0.0",
  "description": "薄契约层 + 可靠性内核：AgentSpec、AgentEngine 契约、两个受管入口、Journal/幂等/预算/Fencing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/testkit.ts --format esm,cjs --dts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testkit": {
      "types": "./dist/testkit.d.ts",
      "import": "./dist/testkit.js",
      "require": "./dist/testkit.cjs"
    }
  }
}
